{
 "_method": {
  "cli": "clarilayer@0.2.1 dbt-check --project-dir <dir> --json",
  "survey_date": "2026-08-07",
  "aggregates_are_per_category": "No blended cross-category figure is computed. The corpus is 43% vendor packages and 34% Fivetran alone, so a blended number would mostly describe one vendor's CI.",
  "headline_stratum": "projects that ran (exit 0) from the corpus's usable population, minus stale pairs (tool's artifact_skew.stale), empty catalogs (models.built==0), and manifests with 0 model nodes",
  "share_documented_models_with_phantom": "distinct models with >=1 phantom_column / coverage.models.documented",
  "share_models_missing_from_catalog": "model_never_built findings / (models.total - models.ephemeral)",
  "empty_catalog_detection": "tool-native: coverage.models.built == 0 while non-ephemeral models > 0 \u2014 i.e. the catalog holds a relation for none of the project's models",
  "percentile_method": "linear interpolation on the sorted sample (numpy 'linear')",
  "gate_precedence": "first match wins for included_in_headline: unsupported_schema > empty_catalog > no_models > stale. `excluded` counts below use that precedence; `raw_gate_flags` counts each condition independently (they overlap).",
  "adapter_caveat": "Every catalog here is a single-adapter run by construction \u2014 `dbt docs generate` targets one profile. The per-project `catalog_run_adapter` is that adapter. The companion signal `adapter_dispatch_prefix_count` (distinct `<adapter>__` macro prefixes in the manifest) DOES NOT discriminate project adapter breadth: 114 of the 277 projects that ran have exactly 7, because dbt_utils and dbt-core global macros ship snowflake__/bigquery__/postgres__/... implementations into every manifest that installs them. `target_type_conditional_hits` is more selective (61% of projects) but is still contaminated by package macro bodies. Neither is a substitute for parsing the ROOT project's own model code \u2014 the audit should do that."
 },
