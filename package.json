{
  "name": "clarilayer",
  "version": "0.2.1",
  "description": "Connect ClariLayer — the individual-analyst context layer for your data and engineering context (decisions, constraints, incident lessons) — to Claude Code, Cursor, or Codex in one command.",
  "type": "module",
  "bin": {
    "clarilayer": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "QUICKSTART.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --import tsx --test test/*.test.ts",
    "gen:perf-fixture": "node --import tsx scripts/gen-large-manifest.mjs",
    "prepublishOnly": "npm run build",
    "smoke": "node dist/index.js --help"
  },
  "keywords": [
    "clarilayer",
    "mcp",
    "model-context-protocol",
    "claude-code",
    "cursor",
    "codex",
    "analytics",
    "dbt",
    "ai-agents",
    "context-layer",
    "engineering-context",
    "coding-agents",
    "incident-lessons"
  ],
  "license": "MIT",
  "homepage": "https://clarilayer.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clarilayer/clarilayer.git"
  },
  "bugs": {
    "url": "https://github.com/clarilayer/clarilayer/issues"
  },
  "dependencies": {
    "@clack/prompts": "^0.7.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsx": "^4.23.9",
    "typescript": "^5.4.0"
  }
}
